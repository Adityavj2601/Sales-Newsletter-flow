# Public URL where prospects open editions (used in links, previews and emails).
# Locally: http://localhost:3000   In production: https://brief.yourdomain.com
PUBLIC_BASE_URL=http://localhost:3000

# Where the database, uploads and the encryption key live. Mount this as a volume in production.
DATA_DIR=./data

# Optional. Used to encrypt API keys and sign sessions. If empty, one is generated into DATA_DIR/secret.key.
APP_SECRET=

# Optional. Lets an external scheduler call /api/cron?key=... (e.g. Vercel Cron, cron-job.org).
CRON_KEY=

# Set to 1 to stop the built-in every-minute scheduler (e.g. when you use CRON_KEY instead).
DISABLE_SCHEDULER=

# Set to 1 only for local testing: lets the app fetch feeds/pages from localhost or private network addresses.
ALLOW_PRIVATE_FETCH=
